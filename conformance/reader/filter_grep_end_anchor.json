{
  "description": "--grep 'x$' matches at the end of the line, before its newline (Python searched each line with its \\n).",
  "files": [
    {
      "path": "teleclaude/teleclaude.log",
      "lines": [
        "{{T-120}} level=INFO logger=teleclaude msg=\"m\" tail=x",
        "{{T-100}} level=INFO logger=teleclaude msg=\"m\" tail=y",
        "{{T-80}} level=INFO logger=teleclaude msg=\"m\" tail=xx"
      ]
    }
  ],
  "args": [
    "teleclaude",
    "--grep",
    "x$"
  ],
  "follow": null,
  "expect": {
    "exit": 0,
    "stdout": [
      "{{T-120}} level=INFO logger=teleclaude msg=\"m\" tail=x",
      "{{T-80}} level=INFO logger=teleclaude msg=\"m\" tail=xx"
    ],
    "stderr": {
      "match": "exact",
      "value": ""
    }
  }
}
