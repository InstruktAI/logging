{
  "description": "--grep keeps only lines matching the regex (re.search semantics); it applies per line, so a continuation line that does not match is dropped even when its parent matched.",
  "files": [
    {
      "path": "teleclaude/teleclaude.log",
      "lines": [
        "{{T-400}} level=INFO logger=api msg=\"request\"",
        "{{T-350}} level=DEBUG logger=api msg=\"health\"",
        "{{T-300}} level=INFO logger=worker msg=\"tick\"",
        "{{T-250}} level=INFO logger=api.db msg=\"query\"",
        "  continuation of query",
        "{{T-200}} level=DEBUG logger=worker msg=\"tock\""
      ]
    }
  ],
  "args": [
    "teleclaude",
    "--grep",
    "logger=api"
  ],
  "follow": null,
  "expect": {
    "exit": 0,
    "stdout": [
      "{{T-400}} level=INFO logger=api msg=\"request\"",
      "{{T-350}} level=DEBUG logger=api msg=\"health\"",
      "{{T-250}} level=INFO logger=api.db msg=\"query\""
    ],
    "stderr": {
      "match": "exact",
      "value": ""
    }
  }
}
