{
  "description": "--exclude 'tail=x\\Z' drops nothing: Python's \\Z is the absolute end, after the line's newline.",
  "files": [
    {
      "path": "teleclaude/teleclaude.log",
      "lines": [
        "{{T-120}} level=INFO logger=teleclaude msg=\"m\" tail=x",
        "{{T-100}} level=INFO logger=teleclaude msg=\"m\" tail=y",
        "{{T-80}} level=INFO logger=teleclaude msg=\"m\" tail=xx"
      ]
    }
  ],
  "args": [
    "teleclaude",
    "--exclude",
    "tail=x\\Z"
  ],
  "follow": null,
  "expect": {
    "exit": 0,
    "stdout": [
      "{{T-120}} level=INFO logger=teleclaude msg=\"m\" tail=x",
      "{{T-100}} level=INFO logger=teleclaude msg=\"m\" tail=y",
      "{{T-80}} level=INFO logger=teleclaude msg=\"m\" tail=xx"
    ],
    "stderr": {
      "match": "exact",
      "value": ""
    }
  }
}
