{
  "description": "--exclude 'tail=x(?!\\n)' drops only tail=xx: every line is searched with its newline, so a final x is always followed by one.",
  "files": [
    {
      "path": "teleclaude/teleclaude.log",
      "lines": [
        "{{T-120}} level=INFO logger=teleclaude msg=\"m\" tail=x",
        "{{T-100}} level=INFO logger=teleclaude msg=\"m\" tail=y",
        "{{T-80}} level=INFO logger=teleclaude msg=\"m\" tail=xx"
      ]
    }
  ],
  "args": [
    "teleclaude",
    "--exclude",
    "tail=x(?!\\n)"
  ],
  "follow": null,
  "expect": {
    "exit": 0,
    "stdout": [
      "{{T-120}} level=INFO logger=teleclaude msg=\"m\" tail=x",
      "{{T-100}} level=INFO logger=teleclaude msg=\"m\" tail=y"
    ],
    "stderr": {
      "match": "exact",
      "value": ""
    }
  }
}
