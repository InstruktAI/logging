{
  "description": "An unknown level name falls back to the default (INFO for app loggers, WARNING for third-party).",
  "app": "teleclaude",
  "source": null,
  "max_message_chars": null,
  "env": {
    "TELECLAUDE_LOG_LEVEL": "LOUD",
    "TELECLAUDE_THIRD_PARTY_LOG_LEVEL": "chatty"
  },
  "calls": [
    {
      "logger": "teleclaude.core",
      "level": "DEBUG",
      "msg": "app debug dropped",
      "kv": []
    },
    {
      "logger": "teleclaude.core",
      "level": "INFO",
      "msg": "app info",
      "kv": []
    },
    {
      "logger": "httpx",
      "level": "INFO",
      "msg": "third-party info dropped",
      "kv": []
    },
    {
      "logger": "httpx",
      "level": "WARNING",
      "msg": "third-party warning",
      "kv": []
    }
  ],
  "expect": {
    "path": "{{STATE}}/instrukt-ai/teleclaude/teleclaude.log",
    "lines": [
      "level=INFO logger=teleclaude.core msg=\"app info\"",
      "level=WARNING logger=httpx msg=\"third-party warning\""
    ]
  }
}
