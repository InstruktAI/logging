{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>InstruktAI/workflows//renovate/default#v1",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Amsterdam",
  "schedule": ["before 5am every weekday"],
  "automergeStrategy": "squash",
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Group all minor + patch python deps into one weekly PR",
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python deps (minor+patch)",
      "groupSlug": "python-minor-patch"
    },
    {
      "description": "GitHub Actions: batched into one PR",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Runner images are chosen by dist and mirrored in ci.yml; never bump them separately",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["github-runner"],
      "enabled": false
    }
  ],
  "ignorePaths": [".github/workflows/release.yml"]
}
